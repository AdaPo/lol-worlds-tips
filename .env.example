PORT=3000
INVITE_CODE=change-me
ADMIN_TOKEN=long-random-string
# Worlds league ID (verified against the live API); leave as is
ESPORTS_LEAGUE_ID=98767975604431411
# Public key used by lolesports.com, listed in community docs. Sync is off without it.
ESPORTS_API_KEY=
# Only import matches on/after this date. Default: January 1st of the current year
ESPORTS_SINCE=
DB_PATH=./data/app.db
# set to true only if Tailscale Funnel forwards the client IP in X-Forwarded-For
TRUST_PROXY=false
